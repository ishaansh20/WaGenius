# Dependencies
node_modules/
FRONTEND/node_modules/
BACKEND/node_modules/

# Build output
FRONTEND/dist/
FRONTEND/dist-ssr/

# Secrets — never committed
.env
.env.*
!.env.example
BACKEND/.env

# User-uploaded media — not source, and not meant to live in git
BACKEND/uploads/

# Stray archives — redundant backup copies of BACKEND/FRONTEND, not source
BACKEND/backend.zip
FRONTEND/frontend.zip
/backend.zip
/frontend.zip

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor/OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.local
